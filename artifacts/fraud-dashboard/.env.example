# ──────────────────────────────────────────────────────────────
#  FraudGuard Dashboard — Environment Variables
#  Copy this file to .env.local and fill in the values.
#  All VITE_ variables are embedded at build time.
# ──────────────────────────────────────────────────────────────

# API server base URL (required when frontend and API are on different domains)
# Example: https://your-api.railway.app
# Leave empty when both frontend and API are served from the same domain (Replit).
VITE_API_URL=

# ──────────────────────────────────────────────────────────────
#  Replit-managed (set automatically, do not add to .env.local)
# ──────────────────────────────────────────────────────────────
# PORT=
# BASE_PATH=
